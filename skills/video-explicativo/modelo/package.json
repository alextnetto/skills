{
  "name": "video-explicativo",
  "private": true,
  "type": "module",
  "description": "Vídeo explicativo narrado, feito por código: roteiro em cenas, voz sintética e animação sincronizada.",
  "scripts": {
    "postinstall": "playwright install --only-shell chromium",
    "verificar": "node ferramentas/verificar.mjs",
    "validar": "node ferramentas/validar.mjs",
    "custo": "node ferramentas/custo.mjs",
    "vozes": "node ferramentas/vozes.mjs",
    "previa": "node ferramentas/validar.mjs && node ferramentas/previa.mjs",
    "checar": "node ferramentas/checar.mjs",
    "folhas": "node ferramentas/folhas.mjs",
    "narrar": "node ferramentas/narrar.mjs",
    "renderizar": "node ferramentas/renderizar.mjs",
    "montar": "node ferramentas/montar.mjs",
    "revisar": "node ferramentas/revisar.mjs",
    "video": "node ferramentas/validar.mjs && node ferramentas/narrar.mjs && node ferramentas/renderizar.mjs && node ferramentas/montar.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=18"
  }
}
